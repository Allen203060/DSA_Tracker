{
  "manifest_version": 3,
  "name": "Revalgo — Browser Spaced Repetition Companion",
  "version": "1.0.0",
  "description": "1-Click problem and solution code logger for LeetCode and GeeksforGeeks on Microsoft Edge, Chrome, and Chromium browsers.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.leetcode.com/*",
    "*://leetcode.com/*",
    "*://*.geeksforgeeks.org/*",
    "*://geeksforgeeks.org/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Revalgo Browser Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://leetcode.com/*",
        "*://*.geeksforgeeks.org/*",
        "*://geeksforgeeks.org/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://leetcode.com/*",
        "*://*.geeksforgeeks.org/*",
        "*://geeksforgeeks.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["*://*.leetcode.com/*", "*://*.geeksforgeeks.org/*"]
    }
  ]
}
