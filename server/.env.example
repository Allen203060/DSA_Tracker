# ========================================
# DSA Tracker - Environment Variables
# ========================================

# MongoDB Connection String (Local OR MongoDB Atlas)
# E.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/dsa_tracker
MONGODB_URI=mongodb://localhost:27017/dsa_tracker

# Server Port
PORT=5000

# OpenRouter API Key (For NVIDIA Nemotron-3.5)
# Get yours free at: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model Selection
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
